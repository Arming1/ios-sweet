+/* ---- RNDIS (sweetusb=3): control messages in ep0, one response at a time ---- */
+
+static uint32_t ud_rndis_logged;        /* bit per message type: first one logged */
+static unsigned ud_rndis_prints;        /* limit for unknown and malformed input */
+
+static void
+ud_rndis_warn(const char *what, uint32_t v)
+{
+	if (ud_rndis_prints++ < 16) {
+		printf("SWEET USB: rndis %s 0x%08x\n", what, v);
+	}
+}
+
+static const char *
+ud_rndis_name(uint32_t type)
+{
+	switch (type) {
+	case RNDIS_INIT: return "INITIALIZE";
+	case RNDIS_HALT: return "HALT";
+	case RNDIS_QUERY: return "QUERY";
+	case RNDIS_SET: return "SET";
+	case RNDIS_RESET: return "RESET";
+	case RNDIS_KEEPALIVE: return "KEEPALIVE";
+	default: return NULL;
+	}
+}
+
+/* Response header; the caller writes the rest of the message. */
+static void
+ud_rsp_hdr(uint32_t type, uint32_t len, uint32_t id)
+{
+	ud_put_le32(ud_rsp, type);
+	ud_put_le32(ud_rsp + 4, len);
+	ud_put_le32(ud_rsp + 8, id);
+	ud.rsp_len = len;
+}
+
+/* Value of a QUERY OID: n bytes at out. Unknown OIDs are NOT_SUPPORTED. */
+static uint32_t
+ud_oid_get(uint32_t oid, uint8_t *out, uint32_t *n)
+{
+	static const uint32_t supported[] = {
+		RNDIS_OID_GEN_SUPPORTED_LIST, RNDIS_OID_GEN_HARDWARE_STATUS, RNDIS_OID_GEN_MEDIA_SUPPORTED,
+		RNDIS_OID_GEN_MEDIA_IN_USE, RNDIS_OID_GEN_MAXIMUM_FRAME_SIZE, RNDIS_OID_GEN_LINK_SPEED,
+		RNDIS_OID_GEN_TRANSMIT_BLOCK_SIZE, RNDIS_OID_GEN_RECEIVE_BLOCK_SIZE, RNDIS_OID_GEN_VENDOR_ID,
+		RNDIS_OID_GEN_VENDOR_DESCRIPTION, RNDIS_OID_GEN_CURRENT_PACKET_FILTER,
+		RNDIS_OID_GEN_MAXIMUM_TOTAL_SIZE, RNDIS_OID_GEN_MEDIA_CONNECT_STATUS, RNDIS_OID_GEN_PHYSICAL_MEDIUM,
+		RNDIS_OID_GEN_VENDOR_DRIVER_VERSION, RNDIS_OID_GEN_XMIT_OK, RNDIS_OID_GEN_RCV_OK,
+		RNDIS_OID_GEN_XMIT_ERROR, RNDIS_OID_GEN_RCV_ERROR, RNDIS_OID_GEN_RCV_NO_BUFFER,
+		RNDIS_OID_802_3_PERMANENT_ADDRESS, RNDIS_OID_802_3_CURRENT_ADDRESS,
+		RNDIS_OID_802_3_MULTICAST_LIST, RNDIS_OID_802_3_MAXIMUM_LIST_SIZE, RNDIS_OID_802_3_MAC_OPTIONS,
+	};
+	uint32_t v = 0;
+
+	*n = 4;
+	switch (oid) {
+	case RNDIS_OID_GEN_SUPPORTED_LIST:
+		for (unsigned i = 0; i < sizeof(supported) / sizeof(supported[0]); i++) {
+			ud_put_le32(out + 4 * i, supported[i]);
+		}
+		*n = (uint32_t)sizeof(supported);
+		return RNDIS_STATUS_SUCCESS;
+	case RNDIS_OID_GEN_HARDWARE_STATUS:
+	case RNDIS_OID_GEN_MEDIA_SUPPORTED:
+	case RNDIS_OID_GEN_MEDIA_IN_USE:
+	case RNDIS_OID_GEN_MEDIA_CONNECT_STATUS:
+	case RNDIS_OID_GEN_PHYSICAL_MEDIUM:
+	case RNDIS_OID_GEN_XMIT_ERROR:
+	case RNDIS_OID_GEN_RCV_ERROR:
+	case RNDIS_OID_GEN_RCV_NO_BUFFER:
+	case RNDIS_OID_802_3_MAC_OPTIONS:
+		break;
+	case RNDIS_OID_GEN_MAXIMUM_FRAME_SIZE: v = 1500; break;
+	case RNDIS_OID_GEN_LINK_SPEED: v = 4800000; break;      /* units of 100 bps: 480 Mb/s */
+	case RNDIS_OID_GEN_TRANSMIT_BLOCK_SIZE:
+	case RNDIS_OID_GEN_RECEIVE_BLOCK_SIZE:
+	case RNDIS_OID_GEN_MAXIMUM_TOTAL_SIZE: v = 1558; break;
+	case RNDIS_OID_GEN_VENDOR_ID: v = 0x00ffffff; break;
+	case RNDIS_OID_GEN_VENDOR_DRIVER_VERSION: v = 0x00010000; break;
+	case RNDIS_OID_GEN_CURRENT_PACKET_FILTER: v = ud.rndis_filter; break;
+	case RNDIS_OID_GEN_XMIT_OK: v = (uint32_t)ud.tx_frames; break;
+	case RNDIS_OID_GEN_RCV_OK: v = (uint32_t)ud.rx_frames; break;
+	case RNDIS_OID_GEN_VENDOR_DESCRIPTION:
+		memcpy(out, "Sweet iOS", sizeof("Sweet iOS"));
+		*n = (uint32_t)sizeof("Sweet iOS");
+		return RNDIS_STATUS_SUCCESS;
+	case RNDIS_OID_802_3_PERMANENT_ADDRESS:
+	case RNDIS_OID_802_3_CURRENT_ADDRESS:
+		memcpy(out, ud_host_mac, ETHER_ADDR_LEN);
+		*n = ETHER_ADDR_LEN;
+		return RNDIS_STATUS_SUCCESS;
+	case RNDIS_OID_802_3_MULTICAST_LIST:
+		*n = 0;
+		return RNDIS_STATUS_SUCCESS;
+	case RNDIS_OID_802_3_MAXIMUM_LIST_SIZE: v = 32; break;
+	default:
+		*n = 0;
+		ud_rndis_warn("unknown OID", oid);
+		return RNDIS_STATUS_NOT_SUPPORTED;
+	}
+	ud_put_le32(out, v);
+	return RNDIS_STATUS_SUCCESS;
+}
+
+/* One RNDIS control message (len bytes at UD_DATA) from SEND_ENCAPSULATED_COMMAND. */
+static void
+ud_rndis_command(uint32_t len)
+{
+	const uint8_t *m = (const uint8_t *)(ud.dma + UD_DATA);
+	uint32_t type = 0, mlen = 0, id = 0, status = RNDIS_STATUS_SUCCESS;
+	const char *name;
+
+	ud.rsp_len = 0;
+	if (len < 8) {
+		ud_rndis_warn("short command", len);
+		return;
+	}
+	type = ud_get_le32(m);
+	mlen = ud_get_le32(m + 4);
+	if (mlen < 8 || mlen > len) {
+		ud_rndis_warn("bad MessageLength, type", type);
+		return;
+	}
+	if (mlen >= 12) {
+		id = ud_get_le32(m + 8);        /* RequestID (Reserved in RESET) */
+	}
+	name = ud_rndis_name(type);
+	if (name == NULL) {
+		ud_rndis_warn("unknown message type", type);
+		return;
+	}
+	if (!(ud_rndis_logged & (1u << type))) {
+		ud_rndis_logged |= 1u << type;
+		printf("SWEET USB: rndis %s, %u bytes\n", name, mlen);
+	}
+	switch (type) {
+	case RNDIS_INIT:
+		if (mlen < 24) {
+			ud_rndis_warn("short message", type);
+			break;
+		}
+		ud_rsp_hdr(RNDIS_INIT | RNDIS_COMPLETION, 52, id);
+		ud_put_le32(ud_rsp + 12, RNDIS_STATUS_SUCCESS);
+		ud_put_le32(ud_rsp + 16, 1);            /* MajorVersion */
+		ud_put_le32(ud_rsp + 20, 0);            /* MinorVersion */
+		ud_put_le32(ud_rsp + 24, 1);            /* DeviceFlags: connectionless */
+		ud_put_le32(ud_rsp + 28, 0);            /* Medium: 802.3 */
+		ud_put_le32(ud_rsp + 32, 1);            /* MaxPacketsPerTransfer */
+		ud_put_le32(ud_rsp + 36, 1580);         /* MaxTransferSize */
+		ud_put_le32(ud_rsp + 40, 0);            /* PacketAlignmentFactor */
+		ud_put_le32(ud_rsp + 44, 0);            /* AFListOffset */
+		ud_put_le32(ud_rsp + 48, 0);            /* AFListSize */
+		break;
+	case RNDIS_HALT:
+		if (mlen < 12) {
+			ud_rndis_warn("short message", type);
+			break;
+		}
+		/* no response: the host is done, the link goes down */
+		ud.rndis_filter = 0;
+		if (ud.rndis_up) {
+			ud.rndis_up = false;
+			ud_link_event(false);
+		}
+		break;
+	case RNDIS_QUERY: {
+		uint32_t n = 0;
+		if (mlen < 28) {
+			ud_rndis_warn("short message", type);
+			break;
+		}
+		status = ud_oid_get(ud_get_le32(m + 12), ud_rsp + 24, &n);
+		ud_rsp_hdr(RNDIS_QUERY | RNDIS_COMPLETION, 24 + n, id);
+		ud_put_le32(ud_rsp + 12, status);
+		ud_put_le32(ud_rsp + 16, n);            /* InformationBufferLength */
+		ud_put_le32(ud_rsp + 20, 16);           /* data at 8 + 16 = byte 24 */
+		break;
+	}
+	case RNDIS_SET: {
+		uint32_t oid, ilen, ioff;
+		if (mlen < 28) {
+			ud_rndis_warn("short message", type);
+			break;
+		}
+		oid = ud_get_le32(m + 12);
+		ilen = ud_get_le32(m + 16);
+		ioff = ud_get_le32(m + 20);
+		status = RNDIS_STATUS_NOT_SUPPORTED;
+		if ((uint64_t)8 + ioff + ilen > mlen) {
+			status = RNDIS_STATUS_INVALID_DATA;
+		} else if (oid == RNDIS_OID_GEN_CURRENT_PACKET_FILTER) {
+			if (ilen < 4) {
+				status = RNDIS_STATUS_INVALID_LENGTH;
+			} else {
+				ud.rndis_filter = ud_get_le32(m + 8 + ioff);
+				status = RNDIS_STATUS_SUCCESS;
+				if (ud.rndis_filter != 0 && !ud.rndis_up) {
+					/* the host is ready: report the link up once */
+					ud.rndis_up = true;
+					ud_link_event(true);
+				}
+			}
+		} else if (oid == RNDIS_OID_802_3_MULTICAST_LIST) {
+			status = RNDIS_STATUS_SUCCESS;
+		} else {
+			ud_rndis_warn("unsupported SET OID", oid);
+		}
+		ud_rsp_hdr(RNDIS_SET | RNDIS_COMPLETION, 16, id);
+		ud_put_le32(ud_rsp + 12, status);
+		break;
+	}
+	case RNDIS_RESET:
+		if (mlen < 12) {
+			ud_rndis_warn("short message", type);
+			break;
+		}
+		ud_rsp_hdr(RNDIS_RESET | RNDIS_COMPLETION, 16, RNDIS_STATUS_SUCCESS);
+		ud_put_le32(ud_rsp + 12, 1);            /* AddressingReset */
+		break;
+	case RNDIS_KEEPALIVE:
+		if (mlen < 12) {
+			ud_rndis_warn("short message", type);
+			break;
+		}
+		ud_rsp_hdr(RNDIS_KEEPALIVE | RNDIS_COMPLETION, 16, id);
+		ud_put_le32(ud_rsp + 12, RNDIS_STATUS_SUCCESS);
+		break;
+	default:
+		break;
 	}
 }
 
+/* RESPONSE_AVAILABLE on the interrupt endpoint: 8 bytes, le32 1 and le32 0. */
+static void
+ud_rndis_notify(void)
