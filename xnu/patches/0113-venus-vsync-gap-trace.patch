0113-venus-vsync-gap-trace: AppleCLCD::vsyncFired() records the interval between timer callbacks; a gap over 30 ms is logged
(first 16 only) and every 300 ticks the average and longest gap are printed, to see whether the vsync timer itself runs at
60 Hz while CoreAnimation swaps only a few frames a second. sweetfb_slowcopy=1 restores the row-by-row panel copy (0112's
single memcpy is the default) as a control.

--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -281,6 +281,28 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 	AppleCLCD *fb = (AppleCLCD *)owner;
 	uint64_t now = mach_absolute_time();
 	uint64_t count = ++fb->fVsyncCount;
+	{
+		static uint64_t last_tick, gap_sum, gap_max;
+		static uint32_t ticks, told;
+		uint64_t gap = 0;
+
+		if (last_tick != 0) {
+			absolutetime_to_nanoseconds(now - last_tick, &gap);
+			gap_sum += gap;
+			if (gap > gap_max) {
+				gap_max = gap;
+			}
+			if (gap > 30ull * NSEC_PER_MSEC && told++ < 16) {
+				IOLog("SWEET FB: vsync gap %llu us\n", (unsigned long long)(gap / NSEC_PER_USEC));
+			}
+		}
+		last_tick = now;
+		if (++ticks % 300 == 0) {
+			IOLog("SWEET FB: vsync %u ticks, average gap %llu us, longest %llu us\n", ticks,
+			    (unsigned long long)(gap_sum / (ticks - 1) / NSEC_PER_USEC),
+			    (unsigned long long)(gap_max / NSEC_PER_USEC));
+		}
+	}
 	sweet_fps_tick = now;                                      /* topaz 0943 (SWEET FPS): a store only */
 	/* venus 0104: the vsync payload keeps the venus order (topaz 0945's reorder is dropped) */
 	uint64_t values[6] = {
@@ -426,6 +448,20 @@ get32(const uint8_t *p, uint32_t off)
 	return v;
 }

+/* venus 0113: sweetfb_slowcopy=1 keeps the row-by-row panel copy (a control for 0112). */
+static bool
+sweet_fb_slow_copy(void)
+{
+	static int slow = -1;
+
+	if (slow < 0) {
+		uint32_t on = 0;
+
+		slow = PE_parse_boot_argn("sweetfb_slowcopy", &on, sizeof(on)) && on != 0;
+	}
+	return slow != 0;
+}
+
 static uint32_t sweet_fb_swaps_logged;
 static uint64_t sweet_fb_swap_count;

@@ -612,7 +648,7 @@ AppleCLCD::present(const uint8_t *rec)
 			 * after present returns, so CoreAnimation's frame clock was held near 10 Hz.
 			 * One 18 MB memcpy is several times faster on the same memory.
 			 */
-			if (!s->wrapped && sx == 0 && sy == 0 && dx == 0 && dy == 0 &&
+			if (!sweet_fb_slow_copy() && !s->wrapped && sx == 0 && sy == 0 && dx == 0 && dy == 0 &&
 			    w == (int32_t)fWidth && h == (int32_t)fHeight && s->bytesPerRow == fRowBytes) {
 				memcpy((void *)fPixels, (const void *)(src + s->offset),
 				    (size_t)fRowBytes * (size_t)fHeight);
