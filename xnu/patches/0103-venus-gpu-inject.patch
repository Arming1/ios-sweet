 	if (imgp->ip_argspace < new_ptr_size) {
 		error = E2BIG;
@@ -7472,6 +7631,16 @@ process_signature(proc_t p, struct image_params *imgp)
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 			/* SWEET runs every iOS binary this way: one short line per exec. */
