 		bzero(va, (size_t) size);
 		IOMemoryDescriptor * pm = topaz_gpu_pool_md(pa, size);
 		IOLockLock(gGPULock);
@@ -817,6 +926,7 @@ RedwoodGPUUserClient::gemNew(struct msm_gem_new * request)
 			b->memory = pm;
 			b->kernel = (uint8_t *) va;
 			gGPUStat.made++;
+			gpuTraceMade("pool", size, request->flags, request->handle, pm, b->address);
