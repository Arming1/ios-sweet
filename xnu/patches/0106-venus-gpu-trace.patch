+			gpuTraceMade("kept", size, request->flags, request->handle, b->memory, b->address);
 			IOLockUnlock(gGPULock);
 			if (gGPUKeep == 2) {
 				bzero(b->kernel, (size_t) b->size);
@@ -793,6 +898,7 @@ RedwoodGPUUserClient::gemNew(struct msm_gem_new * request)
 				b->memory = low;
 				b->kernel = (uint8_t *) low->getBytesNoCopy();
 				gGPUStat.made++;
+				gpuTraceMade("low", size, request->flags, request->handle, low, b->address);
 			}
