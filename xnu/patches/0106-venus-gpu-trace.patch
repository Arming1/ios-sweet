0106-venus-gpu-trace: gputrace=1 trace for RedwoodGPU (iokit/Kernel/arm/RedwoodGPU.cpp, the 0102 state).
Panic on the phone right after "RedwoodGPU: client backboardd (open 1)": "phystokv_range: illegal PA: 0xe0164000"
(phys base 0x100000000, size 0xfcc00000). This patch prints "GPUTRACE:" lines by printf for each request
(selector, struct sizes, first scalars), each memory handed out or made (size, flags, first physical
segment, GPU address), each IOSurface taken, each cache flush (VA and PA) and each command buffer of a
submission (at most 8 per submission), and stops at 2000 lines. boot-arg gputrace is read once; without
it the helpers return before any physical-address call, so behaviour is unchanged.

--- a/iokit/Kernel/arm/RedwoodGPU.cpp
+++ b/iokit/Kernel/arm/RedwoodGPU.cpp
@@ -47,6 +47,7 @@
 #include "SweetSurface.h"
 
 extern "C" void redwood_tl(const char * format, ...) __printflike(1, 2);
+extern "C" int printf(const char * format, ...) __printflike(1, 2);
 bool topaz_surface_drawn(SweetSurface * surface, uint64_t milliseconds);
 
 extern "C" {
@@ -180,6 +181,24 @@ struct redwood_show {
 #define GPU_ASK_AGAIN_US        200             /* while waiting for the core: how long between two looks at how far it is */
 #define GPU_PUSH_AGAIN_MS       4               /* a surface is pushed out of the cache again for a submission this long after the last */
 
+/*
+ * Boot-arg gputrace=1 (venus 0106): "GPUTRACE:" lines by printf (synchronous, to the console) for
+ * each request of a program's (externalMethod), each buffer handed out (clientMemoryForType) or
+ * made (gemNew), each IOSurface taken (surfaceBuffer), each cache flush and each command buffer of
+ * a submission, with physical addresses where there are some. Read once; off runs none of it.
+ * At most GPUTRACE_LINES lines in all.
+ */
+static TUNABLE(uint32_t, gGPUTrace, "gputrace", 0);
+static uint32_t gGPUTraceLines;
+#define GPUTRACE_LINES          2000
+#define GPUTRACE(...) \
+	do { \
+		if (gGPUTrace != 0 && gGPUTraceLines < GPUTRACE_LINES) { \
+			gGPUTraceLines++; \
+			printf("GPUTRACE: " __VA_ARGS__); \
+		} \
+	} while (0)
+
 static IOLock * gGPULock;                       /* around everything that is the GPU's (redwood_gpu_...) */
 static bool gGPUReported;
 static bool gGPUCached;                         /* boot-arg gpucached=1 */
@@ -406,6 +425,91 @@ struct gpu_kept {
 #define GPU_KEEP_FROM           (256u << 10)    /* bytes: smaller ones are not worth it */
 static TUNABLE(uint32_t, gGPUKeep, "gpu_keep", 1);      /* boot-arg gpu_keep=0 (a test): none kept; gpu_keep=2: kept ones cleared when given again */
 
+/* gputrace (venus 0106): the trace helpers; each does nothing, and calls no getPhysicalSegment(), unless gputrace=1. */
+static bool
+gpuTraceOn(void)
+{
+	return gGPUTrace != 0 && gGPUTraceLines < GPUTRACE_LINES;
+}
+
+/* the first up to 4 physical segments of a memory descriptor, one line each */
+static void
+gpuTraceSegments(const char * what, IOMemoryDescriptor * memory)
+{
+	uint64_t offset = 0, total;
+
+	if (!gpuTraceOn() || memory == NULL) {
+		return;
+	}
+	total = memory->getLength();
+	GPUTRACE("%s: %llu bytes\n", what, (unsigned long long) total);
+	for (uint32_t i = 0; i < 4 && offset < total; i++) {
+		IOByteCount length = 0;
+		addr64_t pa = memory->getPhysicalSegment(offset, &length, kIOMemoryMapperNone);
+
+		GPUTRACE("  segment %u at +%llu: pa %#llx, %llu bytes\n", i, (unsigned long long) offset,
+		    (unsigned long long) pa, (unsigned long long) length);
+		if (length == 0) {
+			break;
+		}
+		offset += length;
+	}
+}
+
+/* a buffer made or kept for a program: its size, flags, handle, the first segment of its memory and the GPU address */
+static void
+gpuTraceMade(const char * how, uint64_t size, uint32_t flags, uint32_t handle, IOMemoryDescriptor * memory, uint64_t address)
+{
+	IOByteCount length = 0;
+	addr64_t pa = 0;
+
+	if (!gpuTraceOn()) {
+		return;
+	}
+	if (memory != NULL) {
+		pa = memory->getPhysicalSegment(0, &length, kIOMemoryMapperNone);
+	}
+	GPUTRACE("gem new (%s): %llu bytes, flags %#x, handle %u, first segment pa %#llx (%llu bytes), gpu address %#llx\n",
+	    how, (unsigned long long) size, flags, handle, (unsigned long long) pa, (unsigned long long) length,
+	    (unsigned long long) address);
+}
+
+/* an IOSurface taken as a buffer: its ID, size and first segment, before it is used */
+static void
+gpuTraceSurface(SweetSurface * s, uint32_t handle)
+{
+	IOByteCount length = 0;
+	addr64_t pa = 0;
+
+	if (!gpuTraceOn()) {
+		return;
+	}
+	if (s->memory != NULL) {
+		pa = s->memory->getPhysicalSegment(0, &length, kIOMemoryMapperNone);
+	}
+	GPUTRACE("surface: id %u, %ux%u, allocSize %u, wrapped %u, gpuPool %u, request handle %u, first segment pa %#llx "
+	    "(%llu bytes)\n", (unsigned) s->id, (unsigned) s->width, (unsigned) s->height, (unsigned) s->allocSize,
+	    (unsigned) s->wrapped, (unsigned) s->gpuPool, handle, (unsigned long long) pa, (unsigned long long) length);
+}
+
+/* a cache flush of a submission's buffer: the kernel address it is done by, and the physical address it is at */
+static void
+gpuTraceFlush(uint32_t index, struct gpu_buffer * b)
+{
+	IOByteCount length = 0;
+	addr64_t pa = 0;
+
+	if (!gpuTraceOn()) {
+		return;
+	}
+	if (b->memory != NULL) {
+		pa = b->memory->getPhysicalSegment(0, &length, kIOMemoryMapperNone);
+	}
+	GPUTRACE("submit: flush buffer %u: va %#llx, pa %#llx (%llu contiguous), %llu bytes\n", index,
+	    (unsigned long long)(uintptr_t) b->kernel, (unsigned long long) pa, (unsigned long long) length,
+	    (unsigned long long) b->size);
+}
+
 class RedwoodGPUUserClient : public IOUserClient
 {
 	OSDeclareDefaultStructors(RedwoodGPUUserClient);
