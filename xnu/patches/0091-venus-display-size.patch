+/* "WxH" with decimal digits only, e.g. "1284x2778"; false for anything else. */
+static bool
+sweet_parse_size(const char *s, int *w, int *h)
+{
+	int v[2] = { 0, 0 };
+	int i = 0;
+
+	for (int part = 0; part < 2; part++) {
+		int digits = 0;
+		while (s[i] >= '0' && s[i] <= '9') {
+			if (++digits > 5) {
+				return false;
+			}
+			v[part] = v[part] * 10 + (s[i++] - '0');
+		}
+		if (digits == 0 || (part == 0 && s[i++] != 'x')) {
+			return false;
+		}
+	}
+	if (s[i] != '\0') {
+		return false;
+	}
+	*w = v[0];
+	*h = v[1];
+	return true;
+}
