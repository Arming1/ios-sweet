+/*
+ * sweetunlink=PATH: delete one file of the root filesystem before launchd
+ * starts, e.g. MobileGestalt's cache after a display size change (it keeps
+ * the old screen answers otherwise). Absolute paths only.
+ */
+static void
+sweet_boot_unlink(void)
+{
+	char path[256];
+	if (!PE_parse_boot_argn("sweetunlink", path, sizeof(path)) || path[0] != '/') {
+		return;
+	}
+	int error = unlink1(vfs_context_kernel(), NULLVP, CAST_USER_ADDR_T(path), UIO_SYSSPACE, 0);
+	printf("SWEET: sweetunlink %s -> %d\n", path, error);
+}
