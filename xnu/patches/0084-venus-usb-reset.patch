+/*
+ * Bus reset or disconnect (Linux dwc3 dwc3_stop_active_transfers): end the
+ * data transfers the host left active, drop the data endpoints, free the
+ * queued frames, and report the link down.
+ */
+static void
+ud_end_transfer(unsigned ep)
+{
+	if (ud.xfer_active[ep]) {
+		ud_epcmd(ep, DEPCMD_ENDTRANSFER | DEPCMD_HIPRI_FORCERM | DEPCMD_PARAM(ud.xfer_rsc[ep]), 0, 0, 0);
+		delay(100);
+		ud.xfer_active[ep] = false;
+	}
+}
+
+static void
+ud_stop_data(void)
+{
+	ud_end_transfer(EP_RX);
+	ud_end_transfer(EP_TX);
+	ud_end_transfer(EP_INT);
+	dwc_wr(DALEPENA, 0x3);
+	if (ud.lock != NULL) {
+		lck_mtx_lock(ud.lock);
+		for (unsigned i = 0; i < ud.txq_count; i++) {
+			mbuf_freem(ud.txq[(ud.txq_head + i) % UD_TXQ]);
+		}
+		ud.txq_head = ud.txq_count = 0;
+		ud.tx_busy = false;
+		lck_mtx_unlock(ud.lock);
+	}
+	if (ud.configured) {
+		ud.configured = false;
+		ud_link_event(false);
+	}
+	ud.data_alt = 0;
+}
