--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -18,12 +18,14 @@
 #define SWEET                     1
 
 /*
- * All eight cores (six A55 + two A76) as one homogeneous SMP cluster:
- * cpus=N is clamped here. Same ISA level (ARMv8.2), 64-byte lines, PSCI
- * CPU_ON; the scheduler does not know the A76s are faster (no AMP/P-E
- * clusters yet).
+ * venus: eight cores in two clusters. The four A55s are the E cluster
+ * (boot cluster, CPU 0); the three A78s plus the X1 are the P cluster. The
+ * split is set by the ADT "cluster-type" property ('E'/'P', see
+ * tools/mkadt.py). With __ARM_AMP__ the Edge scheduler keeps threads on P
+ * and spills to E (no CLPC).
  */
 #define SWEET_SMP_MAX_CPUS         8
+#define __ARM_AMP__               1
 
 #define ARM_ARCH_TIMER
 #define __ARM_ARCH__              8
