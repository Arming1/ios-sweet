--- /dev/null
+++ b/iokit/Kernel/arm/SweetBusy.cpp
@@ -0,0 +1,87 @@
+/*
+ * Read-only diagnostic: which IOService keeps IOKit busy. Settings > About stalls in
+ * SCNetworkInterfaceCopyAllWithPreferences -> __wait_for_IOKit_to_quiesce, which waits
+ * for busy state to drain. Six rounds, first one 60 seconds after start: prints each
+ * busy IOService (name, class, busy count, provider). No registry changes, matching
+ * or property writes. sweetbusy=0 disables it.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IORegistryEntry.h>
+
+extern "C" void sweet_busy_start(void);
+
+#define BUSY_ROUNDS     6
+#define BUSY_MAX_PRINT  80
+
+static void
+busy_round(int round)
+{
+	IOService *root = IOService::getServiceRoot();
+	printf("SWEET BUSY: round %d root busy=%u\n", round, root ? root->getBusyState() : 0);
+	IORegistryIterator *it = IORegistryIterator::iterateOver(gIOServicePlane, kIORegistryIterateRecursively);
+	if (it == NULL) {
+		printf("SWEET BUSY: round %d no registry iterator\n", round);
+		return;
+	}
+	unsigned visited = 0, busy = 0, shown = 0;
+	OSObject *object;
+	while ((object = it->getNextObject()) != NULL) {
+		IOService *s = OSDynamicCast(IOService, object);
+		if (s == NULL) {
+			continue;
+		}
+		visited++;
+		if (s->getBusyState() == 0) {
+			continue;
+		}
+		busy++;
+		if (shown < BUSY_MAX_PRINT) {
+			shown++;
+			IOService *p = s->getProvider();
+			printf("SWEET BUSY: %s class=%s busy=%u provider=%s\n", s->getName(),
+			    s->getMetaClass()->getClassName(), s->getBusyState(), p ? p->getName() : "-");
+		}
+	}
+	if (round == 0) {
+		printf("SWEET BUSY: visited %u services\n", visited);
+	}
+	printf("SWEET BUSY: round %d %u busy services\n", round, busy);
+	it->release();
+}
+
+static void
+busy_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	for (int round = 0; round < BUSY_ROUNDS; ++round) {
+		IOSleep(round == 0 ? 60000 : 30000);
+		busy_round(round);
+	}
+	(void)thread_terminate(current_thread());
+}
+
+void
+sweet_busy_start(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	(void)PE_parse_boot_argn("sweetbusy", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET BUSY: disabled (sweetbusy=0)\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(busy_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET BUSY: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
