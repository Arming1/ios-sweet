+/*
+ * venus 0109: at most every 2 seconds, how many screen-sized surfaces the table holds and how much
+ * memory is wired (called at the end of create). The count is under the lock.
+ */
+static void
+sweet_surf_summary(void)
+{
+	static uint64_t summary_at;             /* mach_absolute_time from which the next line may come */
+	uint64_t now, gap, wired;
+	uint32_t alive = 0;
+
+	if (gSurfTrace == 0) {
+		return;
+	}
+	now = mach_absolute_time();
+	IOLockLock(sweet_surface_lock);
+	if (now < summary_at) {
+		IOLockUnlock(sweet_surface_lock);
+		return;
+	}
+	nanoseconds_to_absolutetime(2000000000ull, &gap);
+	summary_at = now + gap;
+	for (uint32_t id = 1; id < SWEET_SURFACE_MAX_ID; id++) {
+		if (sweet_surface_table[id] != NULL && sweet_surf_screen(sweet_surface_table[id])) {
+			alive++;
+		}
+	}
+	wired = sweet_surface_wired;
+	IOLockUnlock(sweet_surface_lock);
+	if (sweet_surf_trace_line()) {
+		printf("SURFTRACE: alive screen-sized: %u, wired %llu MB\n", alive, (unsigned long long)(wired >> 20));
+	}
+}
