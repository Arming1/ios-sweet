+/*
+ * venus 0109: boot-arg surftrace=1 (read once). "SURFTRACE:" lines by printf for screen-sized
+ * surfaces (width >= 1000 and height >= 2000): each user taken and given back (get, put), each
+ * release by a client, each free, each import, close and reap by the GPU (RedwoodGPU.cpp), and
+ * every 2 seconds how many are alive. At most SURFTRACE_LINES lines in all. Off, nothing is
+ * printed and nothing is counted.
+ */
+static TUNABLE(uint32_t, gSurfTrace, "surftrace", 0);
+static SInt32 gSurfTraceLines;
+#define SURFTRACE_LINES         4000
+
+bool sweet_surf_trace_line(void);
+
+static bool
+sweet_surf_screen(const SweetSurface *s)
+{
+	return s->width >= 1000 && s->height >= 2000;
+}
+
+/* Whether a SURFTRACE line may be printed now: it is counted, so the caller prints it. */
+bool
+sweet_surf_trace_line(void)
+{
+	return gSurfTrace != 0 && OSIncrementAtomic(&gSurfTraceLines) < SURFTRACE_LINES;
+}
