+static IOReturn
+sweet_surface_gpu_pool(SweetSurface *s)
+{
+	void *va = NULL;
+	/* 64 guard rows past the picture: the GPU writes whole tiles (topaz 0932) */
+	uint64_t take = s->allocSize + 64ull * s->bytesPerRow;
+	uint64_t pa = topaz_gpu_pool_alloc(take, &va);
+	IOMemoryDescriptor *md = pa != 0 ? topaz_gpu_pool_md(pa, s->allocSize) : NULL;
+
+	if (md == NULL) {
+		if (pa != 0) {
+			topaz_gpu_pool_free(pa, take);
+		}
+		return kIOReturnSuccess;
+	}
+	s->poolSize = take;
+	for (uint64_t i = 0; i < take; i += 8) {
+		*(volatile uint64_t *)((uint8_t *)va + i) = 0;
+	}
+	s->memory = md;
+	s->gpuPool = true;
+	s->scanoutPhys = pa;
+	s->mapCache = kIOMapDefaultCache;       /* (the descriptor says write-combined) */
+	return sweet_surface_publish(s) ? kIOReturnSuccess : kIOReturnNoResources;
+}
