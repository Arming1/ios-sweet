+/*
+ * venus-merge: topaz 0942/0943/0946 (SWEET FPS line, boot-arg sweetfps=1 only). Frames reaching
+ * swap(): how many a second, the longest gap, how many came more than 20 ms after the one before,
+ * and how long after the vsync tick they came. Topaz's "latch wait" term is not ported (it
+ * measures the direct path 0933, which is not in this merge).
+ */
+static uint64_t sweet_fps_after_ns;
+
+static void
+sweet_fps_count(void)
+{
+	static int on = -1;
+	if (on < 0) {
+		uint32_t v = 0;
+		on = PE_parse_boot_argn("sweetfps", &v, sizeof(v)) && v != 0;
+	}
+	if (!on) {
+		return;
+	}
+	static uint64_t last, window, gap_max;
+	static uint32_t frames, late;
+	uint64_t now = mach_absolute_time(), ns = 0, gap = 0;
+
+	if (last != 0) {
+		absolutetime_to_nanoseconds(now - last, &gap);
+	}
+	last = now;
+	if (window == 0 || gap > 500000000ull) {
+		window = now;
+		frames = late = 0;
+		gap_max = 0;
+		sweet_fps_after_ns = 0;
+		return;
+	}
+	frames++;
+	late += gap > 20000000ull;
+	if (sweet_fps_tick != 0 && now > sweet_fps_tick) {
+		uint64_t after = 0;
+		absolutetime_to_nanoseconds(now - sweet_fps_tick, &after);
+		sweet_fps_after_ns += after;
+	}
+	gap_max = gap > gap_max ? gap : gap_max;
+	absolutetime_to_nanoseconds(now - window, &ns);
+	if (ns >= 1000000000ull) {
+		IOLog("SWEET FPS: %u frames in %llu ms, longest gap %llu ms, %u late; a frame came %llu us after the tick\n",
+		    frames, ns / 1000000, gap_max / 1000000, late,
+		    frames ? sweet_fps_after_ns / 1000 / frames : 0);
+		sweet_fps_after_ns = 0;
+		window = now;
+		frames = late = 0;
+		gap_max = 0;
+	}
+}
