0111-venus-present-wait-and-share: AppleCLCD::present() times its topaz_surface_drawn() wait (the first 16 waits of 5 ms or
more are logged) and boot-arg sweetfbnowait=1 skips it; RedwoodGPUUserClient::surfaceBuffer() sizes the shared range from the
picture plus 64 guard rows instead of allocSize, so 1440x3200 screen surfaces are shared, and logs why a surface is not shared.

--- a/iokit/Kernel/arm/RedwoodGPU.cpp
+++ b/iokit/Kernel/arm/RedwoodGPU.cpp
@@ -986,7 +986,7 @@ RedwoodGPUUserClient::surfaceBuffer(struct redwood_surface * request)
 	SweetSurface * s = sweet_surface_copy(request->surface);
 	struct gpu_buffer * b = NULL;
 	IOMemoryDescriptor * memory;
-	uint64_t size, began = mach_absolute_time();
+	uint64_t size, picture, want, began = mach_absolute_time();

 	if (s == NULL) {
 		return kIOReturnNotFound;
@@ -1038,14 +1038,27 @@ RedwoodGPUUserClient::surfaceBuffer(struct redwood_surface * request)
 	 * gpu_identity=0: the SMMU translates, the buffer's pages need not be contiguous. The GPU's
 	 * whole tiles past the last row need pages behind them (a fault otherwise): the 64 rows
 	 * SweetSurface allocates beyond the picture, when the descriptor has them.
+	 *
+	 * venus 0111: the shared range is the picture plus those 64 guard rows, not allocSize. A
+	 * 1440x3200 screen surface keeps the allocSize of the two-plane b3a8 request (23,150,592)
+	 * after 0108 makes it one-plane BGRA, so allocSize plus 64 rows (23.5 MB) could exceed what
+	 * was allocated and eagl copied the picture up every frame (18 MB). The picture plus the
+	 * guard rows is 18.8 MB and fits, so the GPU can read the surface where it is.
 	 */
+	picture = round_page_64((uint64_t)s->bytesPerRow * (uint64_t)s->height);
+	want = round_page_64(picture + 64ull * s->bytesPerRow);
 	size = round_page_64(s->allocSize);
 	if (!redwood_gpu_identity() && !s->wrapped) {
 		IOBufferMemoryDescriptor * bmd = OSDynamicCast(IOBufferMemoryDescriptor, s->memory);
-		uint64_t want = round_page_64(s->allocSize + 64ull * s->bytesPerRow);
-		if (bmd != NULL && bmd->getLength() >= want) {
+		if (bmd != NULL && want != 0 && bmd->getLength() >= want) {
 			size = want;
 		} else if (!s->gpuPool) {
+			static uint32_t told;
+			if (told++ < 16) {
+				IOLog("RedwoodGPU: surface %u (%ux%u fmt %#x bpr %u alloc %u len %llu) not shared: want %llu\n",
+				    s->id, s->width, s->height, s->pixelFormat, s->bytesPerRow, s->allocSize,
+				    (unsigned long long)s->memory->getLength(), (unsigned long long)want);
+			}
 			s->release();
 			return kIOReturnUnsupported;
 		}
